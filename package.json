{
  "name": "ultron",
  "private": true,
  "version": "0.15.0",
  "description": "ULTRON - private, persistent, voice-first personal AI assistant",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && npm run serve",
    "serve": "node --disable-warning=ExperimentalWarning --import tsx services/gateway/src/main.ts",
    "build": "npm run build -w @ultron/desktop",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "doctor": "node --disable-warning=ExperimentalWarning scripts/doctor.mjs",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "^4.3.2"
    }
  }
}
