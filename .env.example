# Copy to .env only if you prefer files over the Settings screen. Never commit .env.
# The easiest way to configure ULTRON is the in-app Settings page; keys entered there are
# stored server-side in your ULTRON data folder and never shown again.

# Which brain to use: mock | anthropic | openai   (Settings page overrides this once saved)
ULTRON_PROVIDER=mock
# Optional model override. Anthropic default: claude-opus-5-5. OpenAI/local: required, e.g. your Ollama model name.
ULTRON_MODEL=
# Optional server URL, e.g. http://localhost:11434/v1 for Ollama
ULTRON_BASE_URL=

# API keys (only needed for the provider you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Advanced
ULTRON_PORT=7477
# ULTRON_DATA_DIR=C:\Users\you\AppData\Roaming\ULTRON
ULTRON_LOG_LEVEL=info
